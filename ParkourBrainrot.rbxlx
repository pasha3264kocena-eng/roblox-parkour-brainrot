      <Item class="Script" referent="CheckpointScript">
        <Properties>
          <string name="Name">CheckpointScript</string>
          <ProtectedString name="Source"><![CDATA[
local Players = game:GetService("Players")

local function getCheckpointValue(player)
  local existing = player:FindFirstChild("CheckpointCFrame")
  if existing then
    return existing
  end
  local value = Instance.new("CFrameValue")
  value.Name = "CheckpointCFrame"
  value.Value = CFrame.new(0, 8, 0)
  value.Parent = player
  return value
end

local function setupCharacter(player, character)
  local humanoidRoot = character:WaitForChild("HumanoidRootPart", 5)
  local checkpointValue = getCheckpointValue(player)
  if humanoidRoot and checkpointValue.Value then
    humanoidRoot.CFrame = checkpointValue.Value
  end
end

Players.PlayerAdded:Connect(function(player)
  player.CharacterAdded:Connect(function(character)
    setupCharacter(player, character)
  end)
end)

local function bindCheckpoint(part)
  part.Touched:Connect(function(hit)
    local character = hit.Parent
    local humanoid = character and character:FindFirstChildWhichIsA("Humanoid")
    if not humanoid then
      return
    end
    local player = Players:GetPlayerFromCharacter(character)
    if not player then
      return
    end
    local checkpointValue = getCheckpointValue(player)
    checkpointValue.Value = part.CFrame + Vector3.new(0, 4, 0)
  end)
end

local function bindKillPart(part)
  part.Touched:Connect(function(hit)
    local character = hit.Parent
    local humanoid = character and character:FindFirstChildWhichIsA("Humanoid")
    if humanoid then
      humanoid.Health = 0
    end
  end)
end

local zones = workspace:WaitForChild("Zones")
for _, zone in ipairs(zones:GetChildren()) do
  for _, part in ipairs(zone:GetChildren()) do
    if part:IsA("BasePart") and part.Name == "Checkpoint" then
      bindCheckpoint(part)
    elseif part:IsA("BasePart") and part.Name == "KillPart" then
      bindKillPart(part)
    end
  end
end

workspace.DescendantAdded:Connect(function(descendant)
  if descendant:IsA("BasePart") and descendant.Name == "Checkpoint" then
    bindCheckpoint(descendant)
  elseif descendant:IsA("BasePart") and descendant.Name == "KillPart" then
    bindKillPart(descendant)
  end
end)
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="Script" referent="BrainrotRewardScript">
        <Properties>
          <string name="Name">BrainrotRewardScript</string>
          <ProtectedString name="Source"><![CDATA[
local Players = game:GetService("Players")

local rewards = {
  EasyZone = "Common Brainrot",
  MediumZone = "Uncommon Brainrot",
  HardZone = "Rare Brainrot",
}

local function setupLeaderstats(player)
  local leaderstats = Instance.new("Folder")
  leaderstats.Name = "leaderstats"
  leaderstats.Parent = player

  local brainrotCount = Instance.new("IntValue")
  brainrotCount.Name = "Brainrot"
  brainrotCount.Value = 0
  brainrotCount.Parent = leaderstats

  local lastBrainrot = Instance.new("StringValue")
  lastBrainrot.Name = "LastBrainrot"
  lastBrainrot.Value = ""
  lastBrainrot.Parent = leaderstats
end

Players.PlayerAdded:Connect(setupLeaderstats)

local function awardBrainrot(player, zoneName)
  local leaderstats = player:FindFirstChild("leaderstats")
  if not leaderstats then
    return
  end
  local brainrotCount = leaderstats:FindFirstChild("Brainrot")
  local lastBrainrot = leaderstats:FindFirstChild("LastBrainrot")
  if not brainrotCount or not lastBrainrot then
    return
  end
  local rewardName = rewards[zoneName] or "Brainrot"
  brainrotCount.Value = brainrotCount.Value + 1
  lastBrainrot.Value = rewardName
end

local function bindFinish(zone)
  local finish = zone:FindFirstChild("Finish")
  if not finish or not finish:IsA("BasePart") then
    return
  end
  finish.Touched:Connect(function(hit)
    local character = hit.Parent
    local humanoid = character and character:FindFirstChildWhichIsA("Humanoid")
    if not humanoid then
      return
    end
    local player = Players:GetPlayerFromCharacter(character)
    if not player then
      return
    end
    awardBrainrot(player, zone.Name)
  end)
end

local zones = workspace:WaitForChild("Zones")
for _, zone in ipairs(zones:GetChildren()) do
  bindFinish(zone)
end

workspace.DescendantAdded:Connect(function(descendant)
  if descendant:IsA("Folder") and descendant.Parent == zones then
    bindFinish(descendant)
  end
end)
]]></ProtectedString>
